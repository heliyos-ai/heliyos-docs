{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Heliyos",
  "description": "Developer docs for Heliyos, the AI operating system for revenue. Build on its unified customer memory and AI workers with the REST API and the MCP server.",
  "colors": {
    "primary": "#27251E",
    "light": "#FFD037",
    "dark": "#27251E"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://www.heliyos.ai"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FAF7F3",
      "dark": "#1E1C17"
    }
  },
  "fonts": {
    "family": "Geist",
    "source": "/fonts/Geist-Variable.woff2",
    "format": "woff2",
    "heading": {
      "family": "Geist",
      "source": "/fonts/Geist-Variable.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Geist",
      "source": "/fonts/Geist-Variable.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "tabler"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark"
  },
  "thumbnails": {
    "preset": "headline",
    "appearance": "light",
    "surface": "neutral"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/heliyos-ai",
        "icon": "brand-github"
      },
      {
        "label": "LinkedIn",
        "href": "https://www.linkedin.com/company/heliyos",
        "icon": "brand-linkedin"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Join waitlist",
      "href": "https://www.heliyos.ai"
    }
  },
