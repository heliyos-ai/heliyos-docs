#!/bin/sh
# Blocks commits that would publish secrets, private references or off-style copy.
# Enable once per clone: git config core.hooksPath .githooks

# Env files (.env, .env.build, .env.local, ...) never go in. Templates ending in .example may.
envs=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -vE '\.example$')
if [ -n "$envs" ]; then
  echo "pre-commit: refusing to commit env files:" >&2
  echo "$envs" | sed 's/^/  /' >&2
  echo "Unstage them with: git rm --cached <file>" >&2
  exit 1
fi
node scripts/check-content.mjs || exit 1
